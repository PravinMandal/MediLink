# See https://help.github.com/articles/ignoring-files/ for more information about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets live on Vercel, never in the repo
.env*
!.env.example

# local embedded database (seeded demo data)
/.pglite/

# local file uploads (dev storage adapter)
/.uploads/

# visual QA screenshots
/shots/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
