# ---- Database (Supabase Free, ap-south-1) ----
# Runtime: Supavisor TRANSACTION pooler (port 6543) — serverless-safe.
# Migrations (npm run db:migrate): use the DIRECT connection (port 5432).
# Both from Supabase → Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---- Auth ----
# Public origin of the deployment (Better Auth callbacks/redirects)
BETTER_AUTH_URL=https://<your-app>.vercel.app
# Public app URL used for absolute links (e.g. notification emails)
NEXT_PUBLIC_APP_URL=https://<your-app>.vercel.app
# Generate: npx @better-auth/cli generate  (or openssl rand -base64 32)
BETTER_AUTH_SECRET=

# ---- Social sign-in (optional — buttons appear only when set) ----
# Google: https://console.cloud.google.com/apis/credentials (OAuth client, Web)
# Authorized redirect: https://<your-app>.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: https://developer.apple.com/account/resources/identifiers (Services ID)
# Authorized redirect: https://<your-app>.vercel.app/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ---- Email verification + password reset (Resend, free tier) ----
# https://resend.com/api-keys — verification enforces automatically once set.
RESEND_API_KEY=
# Verified sender, e.g. "MediLink <login@mail.yourdomain.com>"
NOTIFY_FROM_EMAIL=
EMAIL_FROM=

# ---- Document storage (Supabase Storage, private bucket) ----
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=medical-documents

# ---- AI (optional — deterministic extractive fallback works without it) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- Scheduler / worker ----
# Required in production. The /api/worker endpoint accepts:
#   Authorization: Bearer <CRON_SECRET>  (preferred, cron-job.org supports headers)
#   x-cron-secret: <CRON_SECRET>
#   /api/worker?cronSecret=<CRON_SECRET>  (last resort for URL-only schedulers)
# Vercel Cron (vercel.json) hits the same path — for URL-only cron, append
# ?cronSecret=... via an external scheduler instead of relying on Vercel headers.
CRON_SECRET=

# ---- Verification provider ----
# manual_review (default-safe) holds doctor/lab verification for human review.
# Do NOT use the mock auto-approve provider in production.
VERIFICATION_PROVIDER=manual_review

# ---- Optional hardening ----
# MALWARE_SCANNER=1  # when set, unscanned uploads stay quarantined until clean
# MEDILINK_PG_DIR=    # override embedded PGlite dir (local dev only)

# ---- Local development only (leave unset in production) ----
# When DATABASE_URL is unset, the app runs on embedded PGlite in .pglite/
